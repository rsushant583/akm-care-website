# Supabase (browser — anon key only)
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
# Optional: enable ONLY after Storage Image Transformations return HTTP 200 (Pro+).
# Keep unset/false on this project — render endpoint currently returns 403.
# VITE_SUPABASE_IMAGE_TRANSFORMS=false

# Server / scripts only — NEVER prefix with VITE_ (never expose to the browser)
SUPABASE_URL=your_supabase_project_url
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Optional canonical site URL override (production default: https://www.akmcare.in)
# VITE_SITE_URL=https://www.akmcare.in

# Public verification tokens (safe in the browser — not secrets)
# VITE_GOOGLE_SITE_VERIFICATION=
# VITE_BING_SITE_VERIFICATION=

# Middleware product 404s use VITE_SUPABASE_URL + VITE_SUPABASE_ANON_KEY at Vercel *runtime*.
# If they are missing, invalid product URLs fail open (HTTP 200) instead of taking the shop down.

# Google Analytics 4 (storefront only — not loaded on /admin/*)
VITE_GA4_MEASUREMENT_ID=G-XXXXXXXXXX
VITE_GA4_ENABLED=false
VITE_GA4_DEBUG=false

# Email (Resend)
VITE_RESEND_API_KEY=your_resend_api_key

# YouTube
VITE_YOUTUBE_API_KEY=your_youtube_data_api_v3_key

# Legacy PIN (unused by /admin portal)
VITE_ADMIN_PIN=AKM2025

# First Super Admin bootstrap (scripts/bootstrap-admin.mjs)
ADMIN_EMAIL=admin@akmcare.com
ADMIN_PASSWORD=ChangeMeStrongPass123!
ADMIN_FULL_NAME=AKM Super Admin
